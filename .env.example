# ─────────────────────────────────────────────────────────────────────────────
# Barista — environment template
#
# Copy to `.env` and adjust:   cp .env.example .env
#
# READ THIS FIRST — there are no secrets in this file, and there never will be.
# Barista is a 100% client-side tool: parsing, type resolution, layout and
# rendering all happen in your browser. There is no backend, no database and no
# upload endpoint, so there is no credential to leak. Every variable below is
# build-time or developer-experience configuration only.
#
# Anything placed in a browser bundle is PUBLIC by definition. If you ever add a
# variable here, assume the whole world can read it. If that is not acceptable,
# it does not belong in this project.
# ─────────────────────────────────────────────────────────────────────────────

# Base href for the built app. Use "/" for a root domain or a local preview, and
# "/barista/" when deploying to GitHub Pages under a project path.
BARISTA_BASE_HREF=/

# Port used by the dev server (`pnpm dev`).
BARISTA_DEV_PORT=4200

# Shown in the UI footer and in bug reports. CI overrides this with the git SHA.
BARISTA_BUILD_LABEL=local

# Feature flag: render the performance HUD (parse/resolve/layout timings) in the
# UI. Handy while working on the pipeline, noisy otherwise.
BARISTA_SHOW_PERF_HUD=false

# Hard cap on how many Java files a single upload may contain. Guards against
# accidentally dropping in a 20k-file monorepo and freezing the tab.
BARISTA_MAX_FILES=2000
