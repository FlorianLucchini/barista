{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm deps:*)",
      "Bash(pnpm principles:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm verify:*)",
      "Bash(pnpm --filter:*)",
      "Bash(npx depcruise:*)",
      "Bash(npx prettier:*)",
      "Bash(node .claude/scripts/:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(codegraph explore:*)",
      "Read(//home/florian/Documents/projects/barista/**)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh repo create:*)",
      "Bash(pnpm publish:*)"
    ],
    "deny": [
      "Bash(git commit:* --no-verify*)",
      "Bash(git push:* --force*)",
      "Read(./.env)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/scripts/post-edit-check.mjs\"",
            "timeout": 45
          }
        ]
      }
    ]
  }
}
